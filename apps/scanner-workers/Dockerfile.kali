# King Malhare Kali scanner worker.
# Real Kali assessment tools with a generic catalog adapter. The worker still
# runs as an unprivileged user, has no published ports and revalidates scope.
FROM kalilinux/kali-rolling

ARG DEBIAN_FRONTEND=noninteractive
ARG HTTPX_VERSION=1.12.0
ARG GRYPE_VERSION=0.121.2
ARG TFSEC_VERSION=1.28.14
ARG TESTSSL_VERSION=3.2.5

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl unzip git openssl \
       python3 python3-pip python3-venv python3-dev build-essential \
       kali-tools-information-gathering \
       kali-tools-vulnerability \
       kali-tools-web \
       kali-tools-database \
       kali-tools-reporting \
       kali-tools-fuzzing \
       kali-tools-sniffing-spoofing \
       kali-tools-top10 \
       nmap nikto sqlmap gobuster whatweb trivy nuclei ffuf subfinder syft gitleaks \
       amass sublist3r whois arp-scan dirsearch paramspider xsstrike exploitdb dalfox \
       assetfinder trufflehog arjun bandit \
    && rm -rf /var/lib/apt/lists/*

# Tools that are not packaged in Kali, pinned to released upstream builds.
RUN curl -fsSL -o /tmp/httpx.zip "https://github.com/projectdiscovery/httpx/releases/download/v${HTTPX_VERSION}/httpx_${HTTPX_VERSION}_linux_amd64.zip" \
    && unzip -q /tmp/httpx.zip -d /usr/local/bin httpx \
    && curl -fsSL "https://github.com/anchore/grype/releases/download/v${GRYPE_VERSION}/grype_${GRYPE_VERSION}_linux_amd64.tar.gz" \
      | tar -xz -C /usr/local/bin grype \
    && curl -fsSL -o /usr/local/bin/tfsec "https://github.com/aquasecurity/tfsec/releases/download/v${TFSEC_VERSION}/tfsec-linux-amd64" \
    && chmod 0755 /usr/local/bin/tfsec \
    && curl -fsSL "https://codeload.github.com/testssl/testssl.sh/tar.gz/refs/tags/v${TESTSSL_VERSION}" \
      | tar -xz -C /opt \
    && mv /opt/testssl.sh-${TESTSSL_VERSION} /opt/testssl \
    && ln -s /opt/testssl/testssl.sh /usr/local/bin/testssl.sh \
    && chmod 0755 /opt/testssl/testssl.sh \
    && rm -f /tmp/httpx.zip

# Product nuclei templates and wordlist are deterministic and bundled.
COPY km_worker/nuclei_templates /opt/nuclei-templates/king-malhare
ENV NUCLEI_TEMPLATES=/opt/nuclei-templates/king-malhare
COPY km_worker/wordlists/common.txt /opt/wordlists/common.txt
ENV DIR_WORDLIST=/opt/wordlists/common.txt

WORKDIR /app
COPY requirements.txt .
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt \
       wafw00f sslyze semgrep schemathesis droopescan kube-hunter

# Prowler, ScoutSuite and Checkov are intentionally left to a derived image:
# their large cloud SDK dependency graphs conflict with the core worker venv.
# The catalog still lists them, and the worker reports them as unavailable
# rather than simulating results. Install them with pinned versions in a
# separate virtualenv if your assessment program requires them.

COPY km_worker ./km_worker

RUN useradd --system --uid 10001 --create-home --shell /usr/sbin/nologin scanner \
    && mkdir -p /tmp/king-malhare-work \
    && chown -R scanner:scanner /app /tmp/king-malhare-work

USER scanner
ENV PATH="/opt/venv/bin:$PATH" \
    HTTPX_PATH=/usr/local/bin/httpx \
    PYTHONUNBUFFERED=1 \
    SCANNER_WORK_DIR=/tmp/king-malhare-work \
    WORKER_HTTP_PORT=8090 \
    HOME=/home/scanner

EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD /opt/venv/bin/python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=3).status==200 else 1)"

CMD ["/opt/venv/bin/python", "-m", "km_worker.main"]
